; Engine configuration file.
; Neon Harbor - open world neon city action game.

config_version=5

[application]

config/name="Neon Harbor"
config/description="Open world action game in a procedurally generated neon city. Drive, run missions, outrun the police."
config/version="1.5.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.015, 0.015, 0.05, 1)

[autoload]

Game="*res://scripts/Game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=12.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.01, 0.01, 0.03, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
